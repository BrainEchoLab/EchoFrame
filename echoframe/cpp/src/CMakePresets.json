{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release - MEX + CLI + Python, CUDA timing",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MATLAB_VERSION": "24.1",
        "EF_BUILD_CLI": "ON",
        "EF_BUILD_MEX": "ON",
        "EF_BUILD_PYTHON": "ON",
        "ENABLE_CUDA_TIMING": "TRUE",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "no-cli",
      "inherits": "default",
      "displayName": "Release - MEX + Python only (no vcpkg)",
      "cacheVariables": {
        "EF_BUILD_CLI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release", "jobs": 16 },
    { "name": "no-cli", "configurePreset": "no-cli", "configuration": "Release", "jobs": 16 }
  ]
}
