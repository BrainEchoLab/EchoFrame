{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "echoframe",
  "version-string": "0.1.0",
  "description": "Dependencies for the EchoFrame command-line tool. The Python extension and the MEX layer do not use any of these.",
  "dependencies": [
    {
      "name": "matio",
      "features": [
        "mat73",
        "zlib"
      ]
    },
    {
      "name": "hdf5",
      "features": [
        "szip",
        "zlib"
      ]
    },
    "zlib"
  ]
}